# API keys for AI vendors, as 1Password secret references (op://vault/item/field).
# This file is safe to commit: it contains pointers, not secrets.
# Use with `aikeys <command>`, e.g. `aikeys python my_script.py`.
#
# Create the items in 1Password first (or point these at existing ones), then
# uncomment. Copy a reference: right-click a field in 1Password → "Copy Secret Reference".

# ANTHROPIC_API_KEY=op://Private/Anthropic API/credential
# OPENAI_API_KEY=op://Private/OpenAI API/credential
# GEMINI_API_KEY=op://Private/Gemini API/credential
