# Contexts: separate git repos that extend this setup for one area of your life.
#
#   ~/config              root: everything you want on this machine in every context
#   ~/Personal/config     a context: applies to ~/Personal
#   ~/Work/config         a context: applies to ~/Work
#   ~/Work/acme/config    a nested context: applies to ~/Work/acme, on top of Work
#
# A context's scope is the folder its repo sits in. `config rebuild` finds the
# contexts that exist (the `search` list below, plus your machine-local list in
# ~/.config/config/contexts), pins each at its current commit, and builds them into
# the same system as root. Nothing about them is ever committed here.
#
# A context flake provides:
#   darwinModules.default   settings on top of root (apps.desktop, hm.*, workspace.gitProfiles, …)
#   devShells.<sys>.default optional: the shell layer for everything under its folder
#   context.name            optional: short name (defaults to the folder path)
#
# For each loaded context, root adds: the folder, a git profile scoped to it (root's
# name and email, a signing key per Mac; the context sets its own email and GitHub
# account in module.nix), and a generated
# `.envrc` that chains to the parent context's and loads the context's devShell.
# Start one with `config context new ~/Work/config`.
{
  config,
  lib,
  user,
  ...
}:
let
  inherit (lib) mkOption types;
  cfg = config.contexts;
  home = "/Users/${user.name}";

  contextType = types.submodule {
    options = {
      name = mkOption { type = types.str; };
      directory = mkOption {
        type = types.str;
        description = "Folder under your home this context applies to, e.g. Work/acme.";
      };
      path = mkOption {
        type = types.str;
        description = "Absolute path of the context's repo.";
      };
      revision = mkOption {
        type = types.str;
        description = "Commit it was built from (`<rev>-dirty` with uncommitted changes, `uncommitted` before the first commit).";
      };
      hasShell = mkOption {
        type = types.bool;
        default = false;
      };
    };
  };
in
{
  options.contexts = {
    search = mkOption {
      type = types.listOf types.str;
      default = [
        "Personal/config"
        "Work/config"
      ];
      description = ''
        Context repos looked for on every `config rebuild`, relative to your home.
        Missing ones are skipped. Add machine-specific ones with `config contexts add`.
      '';
    };

    template = mkOption {
      type = types.path;
      default = ./template;
      internal = true;
      description = "Files copied by `config context new`.";
    };

    loaded = mkOption {
      type = types.listOf contextType;
      default = [ ];
      internal = true;
      description = "Set by `config rebuild`: the contexts in this build.";
    };
  };

  config = lib.mkMerge [
    (lib.mkIf (cfg.loaded != [ ]) {
      workspace.directories = map (c: c.directory) cfg.loaded;

      # Same identity as root by default; a context can set email/name/settings itself.
      workspace.gitProfiles = lib.listToAttrs (
        map (c: lib.nameValuePair c.name { directory = lib.mkDefault c.directory; }) cfg.loaded
      );

      # Which context commits this generation was built from (read by `config`).
      environment.etc."config/contexts.json".text = builtins.toJSON cfg.loaded;

      hm = {
        # These .envrc files are generated by your own config, so direnv trusts them.
        programs.direnv.config.whitelist.exact = map (c: "${home}/${c.directory}/.envrc") cfg.loaded;
      };
    })

    # Each context folder's .envrc, written as a regular file (not a link into the Nix store)
    # so `direnv reload` can touch it. Ones for contexts no longer loaded are removed, but
    # only if they're still the generated file.
    {
      hm =
        { lib, pkgs, ... }:
        let
          envrcs = map (c: {
            path = "${home}/${c.directory}/.envrc";
            source = pkgs.writeText "envrc-${c.name}" ''
              # Generated by ~/config for context "${c.name}" (${c.path}).
              # Edit that repo, not this file. Projects below pick this up with `source_up_if_exists`.
              source_up_if_exists
              ${lib.optionalString c.hasShell "use flake ${c.path}"}
            '';
          }) cfg.loaded;
          paths = map (e: e.path) envrcs;
        in
        {
          home.activation.contextEnvrcs = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
            state="''${XDG_STATE_HOME:-$HOME/.local/state}/config/context-envrcs"
            if [[ -f "$state" ]]; then
              while IFS= read -r f; do
                case " ${lib.concatStringsSep " " paths} " in
                *" $f "*) ;;
                *) if [[ -f "$f" ]] && grep -q '^# Generated by ~/config for context' "$f"; then run rm -f "$f"; fi ;;
                esac
              done <"$state"
            fi
            ${lib.concatMapStrings (e: ''
              run mkdir -p ${lib.escapeShellArg (dirOf e.path)}
              run rm -f ${lib.escapeShellArg e.path}
              run install -m 644 ${e.source} ${lib.escapeShellArg e.path}
            '') envrcs}
            if [[ ! -v DRY_RUN ]]; then
              mkdir -p "$(dirname "$state")"
              printf '%s\n' ${lib.escapeShellArgs paths} >"$state"
            fi
          '';
        };
    }
  ];
}
